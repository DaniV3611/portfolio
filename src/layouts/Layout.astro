---
import "../styles/global.css";
import Header from "../components/Header/Header.tsx";
import CursorGlow from "../components/CursorGlow.tsx";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		{/* Set the theme + motion class before first paint to avoid any flash */}
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("theme") || "system";
					var systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					var dark = stored === "dark" || (stored === "system" && systemDark);
					var root = document.documentElement;
					root.classList.add(dark ? "dark" : "light");
					if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
						root.classList.add("reveal-ready");
					}
				} catch (e) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
		<link rel="icon" type="image/png" href="/code.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Daniel Velasco | Software Developer & AI Engineer</title>
		<meta name="description" content="Software Developer and AI Engineer specializing in full-stack development, AI systems, and cloud architecture." />
		<meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f6f5f3" media="(prefers-color-scheme: light)" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-background text-text-primary font-sans antialiased">
		<!-- Cursor glow effect -->
		<CursorGlow client:load />
		
		<!-- Ambient background effects -->
		<div class="fixed inset-0 bg-grid pointer-events-none"></div>
		<div class="fixed top-0 left-1/4 w-96 h-96 bg-accent/5 rounded-full blur-3xl pointer-events-none"></div>
		<div class="fixed bottom-0 right-1/4 w-96 h-96 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>
		
		<!-- Main content -->
		<div class="relative z-10 flex flex-col items-center px-4 md:px-8">
			<Header client:load />
			<main class="w-full max-w-4xl">
				<slot />
			</main>
			
			<!-- Footer -->
			<footer class="w-full max-w-4xl py-8 mt-12 border-t border-border text-center">
				<p class="text-text-muted text-sm">
					Built with passion by <span class="gradient-text font-medium">Daniel Velasco</span>
				</p>
			</footer>
		</div>

		<!-- Scroll-reveal animations (Motion) -->
		<script>
			import { animate, inView } from "motion";

			const reduceMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			if (!reduceMotion) {
				inView(
					"[data-reveal]",
					(info: any) => {
						const el: HTMLElement = info && info.target ? info.target : info;
						if (!el || el.dataset.revealed) return;

						const delay = Number(el.getAttribute("data-reveal-delay") || 0);
						animate(
							el,
							{ opacity: [0, 1], transform: ["translateY(28px)", "translateY(0px)"] },
							{ duration: 0.7, delay, ease: [0.22, 0.61, 0.36, 1] },
						);
						el.dataset.revealed = "true";
					},
					{ amount: 0.15 },
				);
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}
</style>
