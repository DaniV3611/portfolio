---
import "../styles/global.css";
import Header from "../components/Header/Header.tsx";
import CursorGlow from "../components/CursorGlow.tsx";
import { Github, Linkedin, Mail, ArrowUp } from "@lucide/astro";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		{/* Set the theme + motion class before first paint to avoid any flash */}
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("theme") || "system";
					var systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					var dark = stored === "dark" || (stored === "system" && systemDark);
					var root = document.documentElement;
					root.classList.add(dark ? "dark" : "light");
					if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
						root.classList.add("reveal-ready");
					}
				} catch (e) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
		<link rel="icon" type="image/png" href="/code.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Daniel Velasco | AI Systems & Full-Stack Developer</title>
		<meta
			name="description"
			content="Daniel Velasco builds AI systems and full-stack products that ship to production: RAG pipelines, autonomous agents, and SaaS platforms, from architecture to cloud deployment."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Daniel Velasco | AI Systems & Full-Stack Developer" />
		<meta
			property="og:description"
			content="I build RAG pipelines, autonomous agents, and SaaS platforms, owning the full lifecycle from architecture to cloud deployment."
		/>
		<meta property="og:url" content="https://daniel-velasco.vercel.app/" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f6f5f3" media="(prefers-color-scheme: light)" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-background text-text-primary font-sans antialiased">
		<!-- Scroll progress indicator -->
		<div class="scroll-progress"></div>

		<!-- Cursor glow effect -->
		<CursorGlow client:load />

		<!-- Ambient background: aurora + grid + grain -->
		<div class="aurora" aria-hidden="true">
			<div class="aurora__blob aurora__blob--1"></div>
			<div class="aurora__blob aurora__blob--2"></div>
			<div class="aurora__blob aurora__blob--3"></div>
		</div>
		<div class="fixed inset-0 bg-grid pointer-events-none z-0"></div>
		<div class="grain" aria-hidden="true"></div>

		<!-- Main content -->
		<div class="relative z-10 flex flex-col items-center px-5 md:px-8">
			<Header client:load />
			<main class="w-full max-w-5xl">
				<slot />
			</main>

			<!-- Footer -->
			<footer class="w-full max-w-5xl mt-24 mb-10 pt-10 border-t border-border">
				<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
					<div class="max-w-sm">
						<a href="/#home" class="font-display text-xl font-bold gradient-text">Daniel Velasco</a>
						<p class="mt-3 text-sm text-text-secondary leading-relaxed">
							AI Systems &amp; Full-Stack Developer. Building production AI and
							software, end to end, from architecture to deployment.
						</p>
					</div>

					<div class="flex flex-col sm:flex-row gap-10">
						<nav class="flex flex-col gap-2.5 text-sm">
							<span class="text-xs uppercase tracking-wider text-text-muted mb-1 font-mono">Navigate</span>
							<a href="/#about" class="text-text-secondary hover:text-accent transition-colors w-fit link-underline">About</a>
							<a href="/#experience" class="text-text-secondary hover:text-accent transition-colors w-fit link-underline">Experience</a>
							<a href="/#projects" class="text-text-secondary hover:text-accent transition-colors w-fit link-underline">Projects</a>
							<a href="/#contact" class="text-text-secondary hover:text-accent transition-colors w-fit link-underline">Contact</a>
						</nav>
						<div class="flex flex-col gap-2.5">
							<span class="text-xs uppercase tracking-wider text-text-muted mb-1 font-mono">Connect</span>
							<div class="flex items-center gap-3">
								<a
									href="https://github.com/daniv3611"
									target="_blank"
									rel="noopener noreferrer"
									class="p-2.5 rounded-lg border border-border hover:border-accent/50 text-text-secondary hover:text-text-primary transition-all duration-200"
									aria-label="GitHub"
								>
									<Github class="w-5 h-5" />
								</a>
								<a
									href="https://www.linkedin.com/in/daniel-velasco-gonzalez-1831a12b5/"
									target="_blank"
									rel="noopener noreferrer"
									class="p-2.5 rounded-lg border border-border hover:border-accent/50 text-text-secondary hover:text-text-primary transition-all duration-200"
									aria-label="LinkedIn"
								>
									<Linkedin class="w-5 h-5" />
								</a>
								<a
									href="mailto:dvelascogz@gmail.com"
									class="p-2.5 rounded-lg border border-border hover:border-accent/50 text-text-secondary hover:text-text-primary transition-all duration-200"
									aria-label="Email"
								>
									<Mail class="w-5 h-5" />
								</a>
							</div>
						</div>
					</div>
				</div>

				<div class="mt-10 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-text-muted">
					<p>© {new Date().getFullYear()} Daniel Velasco. Built with Astro, React &amp; Tailwind.</p>
					<a href="/#home" class="hover:text-accent transition-colors inline-flex items-center gap-1.5">
						Back to top <ArrowUp class="w-3.5 h-3.5" />
					</a>
				</div>
			</footer>
		</div>

		<!-- Scroll-reveal + count-up animations (Motion) -->
		<script>
			import { animate, inView } from "motion";

			const reduceMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			if (!reduceMotion) {
				// Reveal elements as they scroll into view
				inView(
					"[data-reveal]",
					(info: any) => {
						const el: HTMLElement = info && info.target ? info.target : info;
						if (!el || el.dataset.revealed) return;

						const delay = Number(el.getAttribute("data-reveal-delay") || 0);
						animate(
							el,
							{ opacity: [0, 1], transform: ["translateY(28px)", "translateY(0px)"] },
							{ duration: 0.7, delay, ease: [0.22, 0.61, 0.36, 1] },
						);
						el.dataset.revealed = "true";
					},
					{ amount: 0.15 },
				);
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}
</style>
