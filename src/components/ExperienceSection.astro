---
import { experience } from "../data/experience";
import ExperiencePoint from "./ExperiencePoint.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section id="experience" class="w-full py-20 md:py-28">
    <SectionHeading
        index="02"
        label="Experience"
        title="Where I've shipped."
        subtitle="Three years across startups, applied-research teams, and my own software company."
    />

    <!-- Timeline -->
    <div class="relative">
        <!-- Timeline line -->
        <div
            class="absolute left-0 md:left-8 top-6 bottom-0 w-px bg-gradient-to-b from-accent via-secondary to-transparent"
        >
        </div>

        <!-- Experience items -->
        <div class="space-y-8">
            {experience.map((exp, index) => (
                <ExperiencePoint experience={exp} index={index} />
            ))}
        </div>
    </div>
</section>
