---
interface Props {
  index: string;
  label: string;
  title: string;
  subtitle?: string;
}

const { index, label, title, subtitle } = Astro.props;
---

<div class="mb-12 md:mb-16" data-reveal>
  <div class="flex items-center justify-between gap-4 mb-5">
    <span class="eyebrow">{label}</span>
    <span class="section-index">{index}</span>
  </div>
  <h2
    class="font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-text-primary text-balance"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-text-secondary">
        {subtitle}
      </p>
    )
  }
</div>
