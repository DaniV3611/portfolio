---
import SectionHeading from "./SectionHeading.astro";
import { Mail, Phone, MapPin, Send, Github, Linkedin, ArrowUpRight } from "@lucide/astro";
---

<section id="contact" class="w-full py-20 md:py-28">
    <SectionHeading
        index="06"
        label="Contact"
        title="Let's build something."
        subtitle="Open to roles, collaborations and freelance work. I usually reply within a day."
    />

    <!-- Contact Card -->
    <div class="relative p-8 md:p-10 rounded-2xl glass-card overflow-hidden" data-reveal>
        <!-- Background gradient -->
        <div class="absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-secondary/5 pointer-events-none"></div>
        <div class="absolute -top-16 -right-16 w-56 h-56 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
            <!-- Left side - Message -->
            <div class="space-y-6">
                <div>
                    <h3 class="font-display text-2xl font-bold text-text-primary mb-3">
                        Have a project, role, or idea?
                    </h3>
                    <p class="text-text-secondary leading-relaxed">
                        Whether you're hiring, want to ship an AI feature, or just want to
                        talk architecture, my inbox is open. Let's make something that
                        makes it to production.
                    </p>
                </div>

                <!-- Quick Contact -->
                <div class="space-y-3">
                    <a
                        href="mailto:dvelascogz@gmail.com"
                        class="flex items-center gap-4 p-4 rounded-xl bg-surface-elevated border border-border hover:border-accent/50 card-lift group"
                    >
                        <div class="p-3 rounded-lg bg-accent/10 group-hover:bg-accent/20 transition-colors">
                            <Mail class="w-5 h-5 text-accent" />
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm text-text-muted">Email</p>
                            <p class="text-text-primary font-medium group-hover:text-accent transition-colors truncate">dvelascogz@gmail.com</p>
                        </div>
                        <ArrowUpRight class="w-5 h-5 text-text-muted group-hover:text-accent transition-colors" />
                    </a>

                    <a
                        href="tel:+573209168731"
                        class="flex items-center gap-4 p-4 rounded-xl bg-surface-elevated border border-border hover:border-secondary/50 card-lift group"
                    >
                        <div class="p-3 rounded-lg bg-secondary/10 group-hover:bg-secondary/20 transition-colors">
                            <Phone class="w-5 h-5 text-secondary" />
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm text-text-muted">Phone</p>
                            <p class="text-text-primary font-medium group-hover:text-secondary transition-colors">+57 320 916 8731</p>
                        </div>
                        <ArrowUpRight class="w-5 h-5 text-text-muted group-hover:text-secondary transition-colors" />
                    </a>

                    <div class="flex items-center gap-4 p-4 rounded-xl bg-surface-elevated border border-border">
                        <div class="p-3 rounded-lg bg-success/10">
                            <MapPin class="w-5 h-5 text-success" />
                        </div>
                        <div>
                            <p class="text-sm text-text-muted">Location</p>
                            <p class="text-text-primary font-medium">Bogotá, Colombia</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right side - Social & CTA -->
            <div class="flex flex-col justify-between gap-8">
                <div>
                    <p class="text-sm text-text-muted uppercase tracking-wider mb-4 font-mono">Find me on</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <a
                            href="https://github.com/daniv3611"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-3 px-5 py-4 rounded-xl bg-surface-elevated border border-border hover:border-accent/50 card-lift group"
                        >
                            <Github class="w-5 h-5 text-text-secondary group-hover:text-accent transition-colors" />
                            <span class="font-medium text-text-secondary group-hover:text-text-primary transition-colors">GitHub</span>
                        </a>
                        <a
                            href="https://www.linkedin.com/in/daniel-velasco-gonzalez-1831a12b5/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-3 px-5 py-4 rounded-xl bg-surface-elevated border border-border hover:border-secondary/50 card-lift group"
                        >
                            <Linkedin class="w-5 h-5 text-text-secondary group-hover:text-secondary transition-colors" />
                            <span class="font-medium text-text-secondary group-hover:text-text-primary transition-colors">LinkedIn</span>
                        </a>
                    </div>
                </div>

                <!-- CTA Button -->
                <a
                    href="mailto:dvelascogz@gmail.com"
                    class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-gradient-to-r from-accent to-accent-muted hover:from-accent-hover hover:to-accent text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-accent/25 hover:shadow-accent/40 glow-accent-hover"
                >
                    <Send class="w-5 h-5" />
                    Send me a message
                </a>
            </div>
        </div>
    </div>
</section>
